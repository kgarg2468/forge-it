{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": false,
    "baseUrl": ".",
    "paths": {
      "@forgeit/shared": ["packages/shared/src/index.ts"],
      "@forgeit/shared/*": ["packages/shared/src/*"],
      "@forgeit/services": ["packages/services/src/index.ts"],
      "@forgeit/services/*": ["packages/services/src/*"],
      "@forgeit/runner": ["packages/runner/src/index.ts"],
      "@forgeit/runner/*": ["packages/runner/src/*"]
    }
  }
}
