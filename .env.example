# ===== MiniMax (model provider) =====
# sk-cp- international key -> MUST use api.minimax.io (wrong host = 401)
MINIMAX_API_KEY=sk-cp-xxxxx
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_PLAN_MODEL=MiniMax-M2.1
MINIMAX_CODE_MODEL=MiniMax-M2.1

# ===== InsForge (shared hosted cloud project; backend for generated apps) =====
INSFORGE_API_BASE_URL=https://ggnw4cuq.us-east.insforge.app
INSFORGE_API_KEY=ik_xxxxx
# Publishable/anon key for generated frontends. If blank, generated apps proxy through ForgeIt backend.
INSFORGE_ANON_KEY=

# ===== Composio (integrations) =====
COMPOSIO_API_KEY=sk_xxxxx
COMPOSIO_AUTH_CONFIG_GMAIL=ac_xxxxx
COMPOSIO_AUTH_CONFIG_SLACK=ac_xxxxx
COMPOSIO_AUTH_CONFIG_STRIPE=ac_xxxxx

# ===== Railway (per-app "Deploy live") =====
RAILWAY_API_TOKEN=railway_xxxxx
RAILWAY_PROJECT_ID=project_xxxxx

# ===== Replicas (background coding-agent review) =====
REPLICAS_API_KEY=replicas_xxxxx
REPLICAS_ENVIRONMENT_ID=env_xxxxx
REPLICAS_REPOSITORY=krishgarg/forge-it
REPLICAS_CODING_AGENT=codex
REPLICAS_MODEL=codex
REPLICAS_API_BASE_URL=https://api.tryreplicas.com

# ===== Cognition / Devin (engineering review sessions) =====
DEVIN_API_KEY=devin_xxxxx
DEVIN_ORG_ID=org_xxxxx
DEVIN_MODE=normal
DEVIN_API_BASE_URL=https://api.devin.ai/v3

# ===== Memoir (launch packet handoff) =====
MEMOIR_WEBHOOK_URL=https://memoir.example.com/hooks/forgeit

# ===== Limrun (mobile QA handoff) =====
LIM_API_KEY=lim_xxxxx
LIMRUN_BASE_URL=https://api.lim.run
LIMRUN_PLATFORM=android
LIMRUN_STREAM_BASE_URL=https://console.limrun.com

# ===== Vercel (frontend deployment metadata) =====
VERCEL_PROJECT_ID=prj_xxxxx
VERCEL_PROJECT_PRODUCTION_URL=forgeit.example.com

# ===== ForgeIt server =====
PORT=8787
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:8787
DATABASE_URL=file:./prisma/dev.db
# base port for spinning up generated-app preview servers
PREVIEW_PORT_BASE=4300
