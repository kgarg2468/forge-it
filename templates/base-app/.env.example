# --- ForgeIt generated-app environment ---
# Vite only exposes variables prefixed with VITE_ to the browser.
# Copy this file to `.env` and fill in the values.

# InsForge project base URL, e.g. https://xxx.insforge.app
VITE_INSFORGE_URL=

# InsForge project / anon key (sent as `Authorization: Bearer ...` and `apikey`)
VITE_INSFORGE_KEY=

# ForgeIt backend base URL (proxies Composio actions), e.g. http://localhost:8787
VITE_FORGEIT_API_URL=

# The ForgeIt tool id (used in the actions execute endpoint)
VITE_TOOL_ID=

# Tool slug — used as the InsForge table prefix: t_<slug>_<entity>
VITE_TOOL_SLUG=

# Display name shown in the UI
VITE_TOOL_NAME=

# When true, high-risk actions are simulated (never executed live)
VITE_DEMO_SAFE=true
